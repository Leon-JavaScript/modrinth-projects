{
  "rules": [
    {
      "name": "Umberella",
      "enabled": true,
      "partialMatch": false,
      "regex": false,
      "ignoreCase": true,
      "filter": "Your Umberella despawned.",
      "locations": [
        "crimson_isle"
      ],
      "hideOriginalMessage": false,
      "announcementMessage": {
        "message": "Umberella despawned.",
        "displayDuration": 4000
      },
      "customSound": {
        "sound_id": "minecraft:block.anvil.land"
      }
    },
    {
      "name": "Clean Hub Chat",
      "enabled": false,
      "partialMatch": true,
      "regex": true,
      "ignoreCase": true,
      "filter": "(selling)|(buying)|(lowb)|(visit)|(/p)|(/ah)|(my ah)",
      "locations": [
        "hub"
      ],
      "hideOriginalMessage": true
    },
    {
      "name": "Mining Ability Alert",
      "enabled": false,
      "partialMatch": true,
      "regex": false,
      "ignoreCase": true,
      "filter": "is now available!",
      "locations": [
        "mining_3",
        "crystal_hollows"
      ],
      "hideOriginalMessage": false,
      "chatMessage": "\u00261Ability",
      "announcementMessage": {
        "message": "\u00261Ability",
        "displayDuration": 3000
      },
      "customSound": {
        "sound_id": "minecraft:entity.arrow.hit_player"
      }
    }
  ],
  "version": 11
}