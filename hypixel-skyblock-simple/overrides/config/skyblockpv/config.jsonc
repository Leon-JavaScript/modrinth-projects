{
    // The version of the config file. Do not change this unless you know what you are doing.
    "rconfig:version": 3,
    "profileSpying": true,
    "profileChatClick": false,
    "profileChatClickOther": false,
    // Valid Values: AUD, ARS, BRL, CAD, CHF, CNH, CZK, CLP, DKK, EUR, GBP, HKD, HUF, INR, IDR, JPY, KRW, MXN, MYR, NZD, NOK, PLN, PHP, RUB, RON, SGD, SEK, THB, TRY, TWD, USD, UAH, VND, ZAR, ZWG, BTC, DOGE, ETH, LTC, SOL
    "currency": "EUR",
    "alignCategoryButtonsLeft": true,
    "showPronouns": true,
    // Valid Values: OFF, OPEN_PV, BREAKDOWN
    "partyFinderMessage": "OFF",
    "disableOutsideHypixel": false,
    "skillOverflow": true,
    "displayScaling": false,
    "theme": "skyblock-pv:darkmode",
    "seenAutoThemes": [],
    "socials": true,
    "rememberLastTab": true,
    // Valid Values: PARTY, FRIENDS, LOBBY
    "autocompleteSources": [
        "PARTY",
        "FRIENDS",
        "LOBBY"
    ],
    "Dev": {
        "devMode": false,
        "hoppityParser": true,
        "sacksParser": true,
        "offlineMode": false
    }
}